{
  "manifest_version": 3,
  "name": "Onze — Nouvel onglet",
  "short_name": "Onze",
  "version": "1.1.0",
  "description": "Un nouvel onglet apaisant : photo du jour, horloge, objectif, tâches, météo, mode Focus, musique, habitudes et synchronisation.",
  "author": "Akram TOUABET",
  "homepage_url": "https://www.akramtouabet.com",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Onze",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "geolocation",
    "notifications",
    "alarms",
    "favicon",
    "identity",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.unsplash.com/*",
    "https://commons.wikimedia.org/*",
    "https://picsum.photos/*",
    "https://fastly.picsum.photos/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ]
}
